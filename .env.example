# Pushover-Zugangsdaten. Nach .env kopieren und ausfüllen; .env wird nicht eingecheckt.

# API-Token der Anwendung, anzulegen unter https://pushover.net/apps/build
PUSHOVER_TOKEN=

# Dein User-Key (oder ein Group-Key) aus dem Pushover-Dashboard
PUSHOVER_USER=

# Optional: nur an ein bestimmtes Gerät senden
#PUSHOVER_DEVICE=
